# MCP: không cần Telegram, nhưng mặc định cần MySQL và cấu hình sync.
PORT=3000
AUTHKIT_ISSUER=https://right-haven-96-staging.authkit.app
MCP_RESOURCE_URL=https://site--checkdon-mcp--6zt5v8kxj6g9.code.run/mcp
# ALLOWED_HOSTS=localhost,127.0.0.1,ten-mien-cua-ban

# Telegram chỉ dùng cho worker; Google còn cần cho đối soát xóa/bản chiếu đơn.
TELEGRAM_BOT_TOKEN=
CHECKDON_WORKBOOK_ID=
GOOGLE_CLIENT_EMAIL=
# Đặt private key thật trong môi trường bảo mật; .env không được commit.
# Dùng chuỗi có dấu nháy kép và escape \n nếu cấu hình key trong .env.
GOOGLE_PRIVATE_KEY=
ORDER_SHEET_NAME=Đơn Hàng
PRODUCT_SHEET_NAME=Sản Phẩm
# Bỏ trống: nhận mọi group/supergroup mà bot được phép đọc, như postdon cũ.
# Nên chỉ định danh sách nhóm thực sự cần nhận đơn, phân cách bằng dấu phẩy.
TELEGRAM_ALLOWED_CHAT_IDS=

# MySQL là nguồn chính; memory chỉ để test/demo, không phải fallback tự động.
DATA_PROVIDER=mysql
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_TLS=true
DB_CA=
# Shared secret HMAC thật trong process, ít nhất 32 ký tự; không commit giá trị.
SHEET_SYNC_SECRET=

# Layout code Postdon; Sheet kế toán cũ có thể chọn accounting và cấu hình mapping.
ORDER_SHEET_LAYOUT=postdon
# ORDER_SHEET_COLUMNS={"key":"_order_key","content":"Nội dung","date":"Ngày","status":"Trạng thái","supplement":"Bổ sung","checked":"Checked","ordersChecked":"Orders_checked"}
